# Prapthi Ai — single-page-app routing for Hostinger (Apache).
# Serve index.html for any path that isn't a real file/folder, so client-side
# routes like /dashboard, /login, /help work on direct load and refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and directories (assets, images, etc.) be served as-is.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Everything else -> the SPA entry point (React Router takes over).
  RewriteRule ^ /index.html [L]
</IfModule>

# Long-cache the fingerprinted assets; never cache index.html so new deploys
# are picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
